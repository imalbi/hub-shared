{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "hub.study-plan/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "exam": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": ["label", "required"],
            "additionalProperties": false
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "subject": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "subject", "title"],
        "additionalProperties": false
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "mix": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["id", "title"],
        "additionalProperties": false
      }
    },
    "method": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "subject": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "phase": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "threads": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "recall": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "kind": {
            "type": "string",
            "enum": ["study", "mock", "review"]
          },
          "minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "file": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "page": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": ["path"],
                        "additionalProperties": false
                      },
                      "minutes": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": ["id", "text"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["id", "title", "steps"],
              "additionalProperties": false
            }
          },
          "check": {
            "type": "string"
          }
        },
        "required": ["id", "subject", "title", "threads", "recall", "kind", "blocks", "check"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "id", "title", "version", "subjects", "threads", "phases", "method", "days"],
  "additionalProperties": false
}
